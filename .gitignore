# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserdatad/

# XcodeGen output (regenerate with `scripts/generate_project.sh`)
Xephon.xcodeproj/

# Per-developer signing xcconfig — bootstrapped from
# Config/Local.xcconfig.example by scripts/generate_project.sh.
# Keeps DEVELOPMENT_TEAM out of git so each developer's team id
# stays local and survives project regeneration.
Config/Local.xcconfig

# SwiftPM
.build/
.swiftpm/
Packages/

# macOS
.DS_Store

# Editor / tooling
.vscode/
.idea/
*.swp

# Python (model conversion scripts)
__pycache__/
.venv/
venv/
*.pyc

# Models (hydrated by scripts/fetch_models.sh, not committed)
Models/*
!Models/.gitkeep

# Audio: never accidentally commit participant recordings.
# Test fixtures under Tests/Fixtures/ are an exception (LFS, see .gitattributes).
*.wav
*.m4a
*.aiff
*.flac
*.mp3
!Tests/Fixtures/**/*.wav
!Tests/Fixtures/**/*.m4a

# Claude Code session state. Ignore contents of `.claude/` rather
# than the directory itself, so the negation below can un-ignore
# the shared `skills/` subtree without git's "parent is excluded"
# rule swallowing the children.
.claude/*
# …except the shared skills, which are project-wide guardrails
# distilled from CLAUDE.md and should travel with the repo.
!.claude/skills/
